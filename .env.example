# PROMPTVAULT: SOVEREIGN AI BUNKER CONFIGURATION

# --- 0. OPERATIONAL MODE ---
# Use 'Dockerfile.dev' for coding (Hot Reloading)
# Use 'Dockerfile' for production (Max efficiency/8GB RAM)
# In production, run: docker compose -f docker-compose.yaml up
# (skips the dev override file)
APP_DOCKERFILE=Dockerfile.dev

# --- 0. OPERATIONAL PORTS (Collision Avoidance) ---
PORT_APP_EXTERNAL=3080
PORT_DB_EXTERNAL=5433
PORT_STUDIO=4984

# --- 1. CORE DATABASE (PostgreSQL + pgvector) ---
# Host is 'db' inside Docker, 'localhost:5433' when running Next.js outside Docker
DATABASE_URL="postgresql://admin:secret@db:5432/promptvault_db"
DB_NAME=promptvault_db
DB_USER=admin
DB_PASSWORD=secret

# --- 2. LOCAL AI ENGINE (freeLLMAPI) ---
# freeLLMAPI runs on the host machine (Docker container) with OpenAI-compatible API.
# Inside Docker: http://host.docker.internal:3001/v1
# From host machine: http://127.0.0.1:3001/v1
LLM_BASE_URL="http://host.docker.internal:3001/v1"
# freeLLMAPI requires a valid API key generated from the dashboard (http://localhost:3001).
# First-run: create admin account → generate API key → paste below.
LLM_API_KEY="your-freeLLMAPI-api-key-here"
# Fast tasks (metadata, tags, translation) vs. heavier analysis/optimization.
# IDs must match exactly what freeLLMAPI reports at GET /v1/models.
DEFAULT_MODEL="auto"
ANALYSIS_MODEL="auto"

# --- 3. RESOURCE SCALING (RAM Management) ---

# >>> OPTION A: PATAGONIA MODE (Optimized for 8GB RAM)
DB_MEM_LIMIT=512M
AI_MEM_LIMIT=4G
APP_MEM_LIMIT=1G

# >>> OPTION B: EXPANDED MODE (Optimized for 16GB RAM)
# DB_MEM_LIMIT=1G
# AI_MEM_LIMIT=8G
# APP_MEM_LIMIT=2G

# --- 4. GLOBAL UI & LOCALIZATION (i18n) ---
NEXT_PUBLIC_APP_URL="http://localhost:3080"
NEXT_PUBLIC_DEFAULT_LOCALE="es"
NEXT_PUBLIC_SUPPORTED_LOCALES="es,en"

# --- 5. SYSTEM TELEMETRY ---
ENABLE_PERFORMANCE_LOGS="true"
PATAGONIA_NODE_ID="GENERAL_ROCA_BASE_01"
