# 🏔️ PROMPTVAULT: SOVEREIGN AI BUNKER CONFIGURATION
# Location: General Roca, Río Negro, Argentina

# --- 0. OPERATIONAL MODE (Bunker Strategy) ---
# Select which Dockerfile to use for the 'app' service
# Use 'Dockerfile.dev' for coding (Hot Reloading)
# Use 'Dockerfile' for production (Max efficiency/8GB RAM)
APP_DOCKERFILE=Dockerfile.dev

# --- 1. CORE DATABASE (PostgreSQL + pgvector) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]
# Note: Host is 'db' when running inside Docker
DATABASE_URL="postgresql://admin:secret@db:5432/promptvault_db"
DB_NAME=promptvault_db
DB_USER=admin
DB_PASSWORD=secret

# --- 2. LOCAL AI ENGINE (Ollama) ---
# Inside Docker, use 'http://ollama:11434'
# From your host machine, use 'http://localhost:11434'
OLLAMA_HOST="http://ollama:11434"
DEFAULT_MODEL="qwen2.5:1.5b"

# --- 3. RESOURCE SCALING (RAM Management) ---
# Choose one option and comment out the other.

# >>> OPTION A: PATAGONIA MODE (Optimized for 8GB RAM)
DB_MEM_LIMIT=512M
AI_MEM_LIMIT=4G
APP_MEM_LIMIT=1G

# >>> OPTION B: EXPANDED MODE (Optimized for 16GB RAM)
# DB_MEM_LIMIT=1G
# AI_MEM_LIMIT=8G
# APP_MEM_LIMIT=2G

# --- 4. GLOBAL UI & LOCALIZATION (i18n) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="es"
NEXT_PUBLIC_SUPPORTED_LOCALES="es,en"

# --- 5. SYSTEM TELEMETRY ---
# Metadata for performance tracking and identity
ENABLE_PERFORMANCE_LOGS="true"
PATAGONIA_NODE_ID="GENERAL_ROCA_BASE_01"